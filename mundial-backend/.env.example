POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mundial
POSTGRES_PASSWORD=mundial
POSTGRES_DB=mundial
# POSTGRES_SSL=require  # odkomentuj dla Neon na produkcji
# max polaczen do bazy z jednego procesu (Neon free ma limit), domyslnie 10
# DB_POOL_MAX=10

# min 32 znaki — backend nie wstanie z krotszym (np. openssl rand -hex 32)
JWT_SECRET=zmien-na-losowy-string-minimum-32-znaki
JWT_EXPIRE_DAYS=7

# wymagaj potwierdzenia emaila przed logowaniem. zostaw false na dev (sandbox
# resend wysyla maile tylko na wlasny adres), ustaw true na produkcji
# ustaw TRUE na produkcji — weryfikacja emaila przed pierwszym logowaniem
REQUIRE_VERIFIED_EMAIL=false

# emaile użytkowników którzy mogą wpisywać wyniki meczów (POST /matches/{id}/result)
# lista oddzielona przecinkami, bez spacji. zobacz docs/decisions.md #005
ADMIN_EMAILS=

FOOTBALL_API_KEY=twoj-klucz-z-football-data.org
RESEND_API_KEY=twoj-klucz-z-resend.com
# adres nadawcy maili. domyslnie sandbox resend.dev (wysyla tylko na twoj email).
# po weryfikacji wlasnej domeny w resend zmien na np. "czutka <noreply@twojadomena.pl>"
EMAIL_FROM=czutka <onboarding@resend.dev>

# ile proxy stoi przed backendem — IP klienta (rate limiting) brane jest z
# X-Forwarded-For liczac od prawej. 1 = jedno proxy (render), 2 = vercel rewrite + render.
# backend loguje raz "x-forwarded-for has N entries" — po tym dobierz wartosc
TRUSTED_PROXY_HOPS=1

# swagger (/docs), redoc i /openapi.json. lokalnie true, na produkcji ustaw false
API_DOCS_ENABLED=true

# na produkcji: https://twojadomena.vercel.app
# wiele originu (dev + prod): http://localhost:5173,https://mundialtyper.vercel.app
FRONTEND_URL=http://localhost:5173

# wstaw testowe dane (48 drużyn, 104 mecze, 5 kont) przy starcie serwera
# ustaw na false na produkcji!
DEV_SEED=false

# synchronizacja z football-data.org (harmonogram w tle, patrz docs/data-source.md)
# false = wylacza job; bez FOOTBALL_API_KEY tez sie nie wlaczy
SYNC_ENABLED=true

# katalog na herby pobrane przez GET /img/crest (cache na dysku, plus LRU w pamieci)
# puste = katalog tymczasowy systemu (/tmp/czutka-crests)
CREST_CACHE_DIR=
